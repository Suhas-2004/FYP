  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend Presentation",
      "items": [
        "Single-Page Application powered by React 18 and Vite (dev server on port 5173)",
        "Rich UI components with Tailwind CSS, Framer Motion, and dark glassmorphic tokens",
        "Role-based persona selector (Entrepreneur, Investor, Researcher) tracking workflow context",
        "Data visualization layer with Recharts (financial metrics, trajectory sparklines, networks)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend API & Computation",
      "items": [
        "Node.js Express REST API server running on port 8000 with CORS & JSON body parsing",
        "Modular router structure with 9 domain routers (companies, crisis, market, startups, news)",
        "In-process calculation engines: similarityEngine (TF-IDF/cosine) and predictionEngine",
        "Subprocess bridging to Python microservices for AI inference and public web ingestion"
      ]
    },
    {
      "dot": "violet",
      "title": "Local AI & Web Research",
      "items": [
        "Zero-paid-API design utilizing local Ollama runtime (:11434) for open-weights models",
        "Public web harvesting pipeline using requests, feedparser, BeautifulSoup, and trafilatura",
        "Local research cache preventing redundant external HTTP fetches and respecting rate limits",
        "Cross-process JSON protocol over stdin/stdout connecting Node.js and Python runtimes"
      ]
    },
    {
      "dot": "amber",
      "title": "Data Persistence & Models",
      "items": [
        "Structured JSON repository in backend/data/ containing 38+ longitudinal company records",
        "Graph data store mapping multidimensional corporate relationships (competitors, suppliers)",
        "Financial news sentiment database integrated with HuggingFace AlfonsoLozana/news dataset",
        "Stocks historical records covering 6 years of OHLCV prices and market capitalization data"
      ]
    }
  ]
